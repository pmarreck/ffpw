#!/usr/bin/env bash
set -uo pipefail
set -E

trap 'echo "ERR at ${BASH_SOURCE[0]}:${LINENO}: $BASH_COMMAND" >&2' ERR

run() {
  "$@" || {
    echo "FAILED: $*" >&2
    exit 1
  }
}

# Local-only PATH-hygiene control (Peter's machines only). After a successful
# build, confirm that the `ffpw` command routes through this repo's `bin` entry
# or resolves to another in-repo artifact. This catches building one binary
# while running a stale or foreign one. Gated on $USER so it NEVER runs in CI,
# which uses `nix build` as user `runner`/`nixbld`. `bin/ffpw` intentionally
# routes through `result` into /nix/store, so recognize that lexical project
# path before canonicalization erases it. A PATH misconfiguration warns without
# failing the build.
check_on_path() {
  [ "${USER:-}" = "pmarreck" ] || return 0
  local tool="ffpw" here resolved real
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  resolved="$(command -v "$tool" 2>/dev/null || true)"
  if [ -z "$resolved" ]; then
    printf '\033[33m⚠ %s is not on PATH — your fresh build will not run by name. Add %s/bin to PATH.\033[0m\n' "$tool" "$here" >&2
    return 0
  fi
  real="$(realpath "$resolved" 2>/dev/null || readlink -f "$resolved" 2>/dev/null || printf '%s' "$resolved")"
  if [ "$resolved" = "$here/bin/$tool" ]; then
    printf '\033[32m✓ %s on PATH → bin/%s → %s\033[0m\n' "$tool" "$tool" "$real" >&2
    return 0
  fi
  case "$real" in
    "$here"/*) printf '\033[32m✓ %s on PATH → %s (this build)\033[0m\n' "$tool" "${real#"$here"/}" >&2 ;;
    *) printf '\033[33m⚠ `%s` on PATH resolves to %s — OUTSIDE this repo; it may be shadowing your fresh build at %s/bin/%s.\033[0m\n' "$tool" "$real" "$here" "$tool" >&2 ;;
  esac
}

optimize="ReleaseFast"
if [[ "${1:-}" == "debug" ]]; then
  optimize="Debug"
  shift
fi

if [[ "$optimize" != "ReleaseFast" ]]; then
  # Non-release builds use zig directly (local dev, no need for Nix reproducibility)
  run zig build "-Doptimize=$optimize" "$@"
elif command -v nix >/dev/null 2>&1; then
  run nix build "$@"
  mkdir -p zig-out/bin
  # `find`, not `result/bin/*`: Peter's shells run noglob (`set -f`), which
  # propagates into scripts and would leave the pattern literal. This is also
  # correct for an empty/missing bin dir (loud failure) and follows `result`,
  # which is a symlink into the nix store.
  run find -L result/bin -maxdepth 1 -type f -perm -u+x -exec install -m755 "{}" zig-out/bin/ ";"
else
  run zig build "-Doptimize=$optimize" "$@"
fi

# A build that installs an unexecutable binary is a failed build, not a warning.
# `nix build` emitted a dynamically-linked musl binary whose interpreter
# (/lib/ld-musl-x86_64.so.1) does not exist on NixOS, so `./build` reported
# success while leaving something that could not run. Exit codes 126/127 are the
# precise signature of "cannot execute" / "loader not found", so a CLI that
# merely returns non-zero from --help does not trip this.
check_runnable() {
  local exe="$1"
  # Cross-compiled output is not expected to run on the build host.
  for a in "$@"; do
    case "$a" in -Dtarget=*) return 0 ;; esac
  done
  [ -e "$exe" ] || { echo "FAILED: $exe was never produced" >&2; exit 1; }
  # `|| ec=$?` keeps this off the ERR trap: the failure is expected and handled.
  local ec=0
  "$exe" --help >/dev/null 2>&1 || ec=$?
  if [ "$ec" -eq 126 ] || [ "$ec" -eq 127 ]; then
    printf '\033[31m✗ %s was installed but cannot execute (exit %d).\033[0m\n' "$exe" "$ec" >&2
    printf '  %s\n' "$(file -b "$exe" 2>/dev/null || echo 'file(1) unavailable')" >&2
    exit 1
  fi
}

check_runnable "zig-out/bin/ffpw" "$@"
check_on_path
