#!/usr/bin/env bash

set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${1:-}" == "--test" ]]; then
	"$root_dir/bin/test/ffpw_test" >/dev/null
	exit $?
fi

exe="$root_dir/zig-out/bin/ffpw"

need_build=0
if [[ ! -x "$exe" ]]; then
	need_build=1
elif [[ "$root_dir/src/main.zig" -nt "$exe" || "$root_dir/build.zig" -nt "$exe" ]]; then
	need_build=1
fi

if [[ "$need_build" -eq 1 ]]; then
	export ZIG_GLOBAL_CACHE_DIR="${FFPW_ZIG_GLOBAL_CACHE_DIR:-$root_dir/.zig-global-cache}"
	mkdir -p "$ZIG_GLOBAL_CACHE_DIR"
	(cd "$root_dir" && zig build)
fi

exec "$exe" "$@"
