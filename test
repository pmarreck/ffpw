#!/usr/bin/env bash
# Run the full ffpw test suite: Zig unit tests + CLI shell tests.
#
# `zig build test` genuinely EXECUTES the compiled test binary — build.zig wires
# an `addRunArtifact` step, not just the compile step. (Depending on the compile
# step alone is a silent false-green: every assertion "passes" because the binary
# is never run. That hid an untested, broken sqlite query path for ~5 weeks.)
#
# META-CONTROL (MFIC): a green is only trustworthy if the harness actually ran
# AND ran every test. This script asserts the executed test count equals the
# number of `test` blocks authored across src/ — so two regressions self-report:
#   (a) the run step going compile-only again  -> no "run test" line       -> FAIL
#   (b) a file dropped from main.zig's aggregator -> executed < authored    -> FAIL
# The count is derived mechanically (not a hand-maintained magic number), so it
# tracks new tests automatically.
#
# CI's Linux leg additionally re-spawns the binary through Nix's dynamic linker
# via `nix build .#checks.<system>.test`. Run `./test nix` for that exact
# sandboxed, host-independent check locally.
#
# No `set -e` — sub-suite failures are accumulated (rc OR) so one failing suite
# never masks or aborts the others.
set -uo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root_dir"

if [[ "${1:-}" == "nix" ]]; then
	system="$(nix eval --raw --impure --expr 'builtins.currentSystem')"
	exec nix build ".#checks.${system}.test" --print-build-logs
fi

rc=0

echo "── Zig unit tests ──"
authored=$(find src -maxdepth 1 -name '*.zig' -exec cat {} + | grep -cE '^test ')
test_out="$(zig build test --summary all 2>&1)"
test_rc=$?
echo "$test_out"

# Parse "run test N pass (M total)" or "run test N pass, K fail (M total)".
re='run test ([0-9]+) pass(, [0-9]+ fail)? \(([0-9]+) total\)'
if [[ "$test_out" =~ $re ]]; then
	passed="${BASH_REMATCH[1]}"
	total="${BASH_REMATCH[3]}"
else
	passed=0
	total=0
fi

if [[ "$test_rc" -ne 0 ]]; then
	echo "✗ unit tests failed" >&2
	rc=1
elif [[ "$total" -eq 0 ]]; then
	echo "✗ META-CONTROL: no 'run test' summary line — the test step compiled but never ran (false green)" >&2
	rc=1
elif [[ "$total" -ne "$authored" ]]; then
	echo "✗ META-CONTROL: executed $total test(s) but $authored authored in src/ — a file is missing from main.zig's test aggregator" >&2
	rc=1
elif [[ "$passed" -ne "$total" ]]; then
	echo "✗ $((total - passed)) test(s) failed" >&2
	rc=1
else
	echo "✓ unit tests passed ($passed/$authored authored tests executed)"
fi

echo "── CLI shell tests ──"
if bash bin/test/ffpw_test; then
	echo "✓ CLI tests passed"
else
	echo "✗ CLI tests failed" >&2
	rc=1
fi

# ── Build script controls ────────────────────────────────────────────────
#
# Two properties, both learned the hard way, checked against the REAL ./build
# with a stubbed `nix` so the suite stays fast:
#
# 1. GLOB-INDEPENDENCE. Peter's shells run `set -f` (noglob), which propagates
#    into scripts, so a bare `result/bin/*` stayed LITERAL and the install step
#    failed — the fresh build never reached zig-out/bin. Exercised with globbing
#    OFF (`bash -f`) *and* ON, because a glob-dependent script still passes the
#    globbing-ON case; only the pair classifies the script correctly.
#
# 2. THE INSTALLED BINARY MUST ACTUALLY RUN. Fixing (1) exposed this: `nix build`
#    emitted a dynamically-linked musl binary whose interpreter does not exist on
#    NixOS, so a "successful" build installed something unexecutable. A control
#    that never fires is not a control, so the non-runnable case is exercised
#    here to prove ./build rejects it rather than assuming it would.
#
# USER is overridden so the local-only PATH-hygiene control stays out of it —
# these are about the install step, not about the host's PATH.
echo "── build script controls ──"
build_tmp="$(mktemp -d)"
mkdir -p "$build_tmp/stub"
cat > "$build_tmp/stub/nix" <<'STUB'
#!/usr/bin/env bash
# Stand-in for `nix build`: materializes ./result -> a store-like dir with bin/.
# STUB_BROKEN=1 emits an executable whose interpreter does not exist, mimicking
# a musl-linked binary on a host that has no musl loader.
mkdir -p "$PWD/_store/bin"
if [[ "${STUB_BROKEN:-0}" == 1 ]]; then
	printf '#!/nonexistent/loader\n' > "$PWD/_store/bin/ffpw"
else
	printf '#!/bin/sh\necho stub\n' > "$PWD/_store/bin/ffpw"
fi
chmod +x "$PWD/_store/bin/ffpw"
ln -sfn "$PWD/_store" "$PWD/result"
STUB
chmod +x "$build_tmp/stub/nix"

# label|bash flag|STUB_BROKEN|expect ./build to succeed?
build_cases=(
	"installs the nix output with globbing off|-f|0|yes"
	"installs the nix output with globbing on||0|yes"
	"rejects an installed binary that cannot execute|-f|1|no"
)
for spec in "${build_cases[@]}"; do
	IFS='|' read -r label flag broken want_ok <<<"$spec"
	if [[ -n "$flag" ]]; then sh_flags=("$flag"); else sh_flags=(); fi
	work="$build_tmp/run-$broken-${#sh_flags[@]}"
	mkdir -p "$work"
	build_out="$(cd "$work" && PATH="$build_tmp/stub:$PATH" USER=not-peter STUB_BROKEN="$broken" \
		bash ${sh_flags[@]+"${sh_flags[@]}"} "$root_dir/build" 2>&1)"
	build_rc=$?
	if [[ "$want_ok" == yes ]]; then
		[[ "$build_rc" -eq 0 && -x "$work/zig-out/bin/ffpw" ]] && ok=1 || ok=0
	else
		[[ "$build_rc" -ne 0 ]] && ok=1 || ok=0
	fi
	if [[ "$ok" -eq 1 ]]; then
		echo "✓ ./build $label"
	else
		echo "✗ ./build $label (rc=$build_rc)" >&2
		printf '%s\n' "$build_out" | sed 's/^/    /' >&2
		rc=1
	fi
done
# Our own mktemp -d under TMPDIR (RAM); nothing user-owned lives here.
rm -rf "$build_tmp"

exit "$rc"
