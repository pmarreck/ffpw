#!/usr/bin/env bash

set -u

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

expected_target="../result/bin/ffpw"
actual_target="$(readlink "$root_dir/bin/ffpw" 2>/dev/null || true)"

if [[ -d "$root_dir/bin" && ! -L "$root_dir/bin" && -L "$root_dir/bin/ffpw" && "$actual_target" == "$expected_target" ]]; then
	printf '✓ project bin executable resolves through the Nix result link\n'
	exit 0
fi

printf '✗ expected real bin/ with ffpw -> %s; found bin=%s ffpw=%s\n' \
	"$expected_target" "$([[ -L "$root_dir/bin" ]] && printf symlink || printf directory)" \
	"${actual_target:-missing or non-symlink}" >&2
exit 1
