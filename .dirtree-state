# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	INTENT.md = Canonical project purpose, scope, constraints, and success evidence
	RULES.md = Durable project rules and owner decisions
	bin = Real PATH-discovered directory; ffpw symlinks to the Nix release result
	bin/ffpw = Relative symlink to ../result/bin/ffpw; stable PATH-facing release executable
	build = Flake-driven release builder; verifies runnable output and PATH routing
	docs/PLAN_LOG.md = Retired completed PLAN items
	docs/plan_context/profile-recency-anomaly.md = Evidence and recurrence trigger for the unresolved profile-selection anomaly
	mutate = Mutation-testing harness: injects known faults, asserts ./test goes red for each (awk-based literal replace)
	src/output.zig = Pure credential-table renderer with UTC Firefox timestamps and lossless-width checks
	test = Full suite runner; Nix checks use --no-link to preserve the release result
	tests/cli = Bash CLI and PATH-layout regression suites
	tests/cli/ffpw_test = CLI behavior tests using isolated synthetic Firefox profiles
	tests/cli/nix_test_link_test = Fake-Nix regression proving check builds preserve the release result link
	tests/cli/path_layout_test = Asserts real bin directory and relative ffpw link through the Nix result
]
